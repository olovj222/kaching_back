# ---------- Etapa 1: compilar ----------
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

# Primero solo el pom: Docker cachea las dependencias mientras el pom no cambie
COPY pom.xml .
RUN mvn -B dependency:go-offline

COPY src ./src
# Sin tests: contextLoads necesita la base de datos, que no existe durante el build
RUN mvn -B clean package -DskipTests

# ---------- Etapa 2: ejecutar ----------
FROM eclipse-temurin:21-jre
WORKDIR /app

RUN useradd --system --no-create-home appuser
COPY --from=build /app/target/*.jar app.jar
USER appuser

EXPOSE 8080

# Flags pensados para la instancia gratuita de Render (512 MB, 0.1 CPU):
#  - MaxRAMPercentage=65     deja margen para metaspace e hilos (no pasarse de 512 MB)
#  - UseSerialGC             GC liviano, ideal para heaps chicos
#  - TieredStopAtLevel=1     arranque mas rapido con poca CPU
#  - user.timezone           LocalDateTime.now() queda en hora de Chile y no en UTC
ENTRYPOINT ["java", \
  "-XX:MaxRAMPercentage=65", \
  "-XX:+UseSerialGC", \
  "-XX:TieredStopAtLevel=1", \
  "-Xss512k", \
  "-Duser.timezone=America/Santiago", \
  "-jar", "app.jar"]